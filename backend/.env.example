# No model/secret is selected automatically. Choose an available Groq model explicitly.
LLM_PROVIDER=disabled
LLM_MODEL=
GROQ_API_KEY=
ORGANIZER_API_KEY=
ORGANIZER_BASE_URL=
LLM_TIMEOUT=45
DATABASE_URL=sqlite:///./legal.db
# Build this with python -m scripts.build_index first, or omit to start with an empty corpus.
INDEX_PATH=data/index/corpus.json
CORPUS_ROOT=data/raw
APP_ENV=public
ADMIN_TOKEN=
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
# Compose database password; local demo value, replace for a shared deployment.
POSTGRES_PASSWORD=local-demo-only
# Local HTTP demo. Set true when serving the application over HTTPS.
AUTH_COOKIE_SECURE=false
AUTH_SESSION_HOURS=8
AUTH_IDLE_MINUTES=30
# Extra exact browser origins, if the reverse proxy changes the original Host.
AUTH_TRUSTED_ORIGINS=[]

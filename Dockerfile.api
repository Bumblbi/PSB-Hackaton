FROM python:3.12-slim
WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
COPY requirements.lock ./
RUN pip install --no-cache-dir -r requirements.lock
COPY . .
RUN useradd --create-home --uid 10001 appuser \
    && python -m scripts.build_index data/demo/manifest.json /app/data/index/corpus.json \
    && chown -R appuser:appuser /app
USER appuser
EXPOSE 8000
CMD ["sh", "-c", "python -m alembic upgrade head && python -m uvicorn apps.api.app.main:app --host 0.0.0.0 --port 8000 --workers 1 --no-access-log"]
